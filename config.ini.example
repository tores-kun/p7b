# Настройки извлечения сертификатов из .p7b.
# Файл читают и GUI, и запуск из консоли (python p7b.py).
# GUI перезаписывает его при изменении настроек.
#
# Naming.Preset — готовый вариант имени файла, одно из:
#   CN | surname | serial | sok_id | CN_serial | surname_serial | CN_sok_id | CN_serial_surname | custom
# Naming.Template используется, когда Preset = custom.
# Поля, доступные в шаблоне:
#   {CN}            — CN (ФИО/наименование)
#   {surname}       — Фамилия
#   {given_name}    — Имя и отчество
#   {first_name}    — Имя
#   {serial}        — Номер сертификата
#   {sok_id}        — ID СОК
#   {subject_id}    — Идентификатор в теме
#   {unp}           — УНП
#   {org}           — Организация
#   {unit}          — Подразделение
#   {position}      — Должность
#   {email}         — Email
#   {thumbprint}    — Отпечаток SHA-1
#   {valid_from}    — Действителен с
#   {valid_to}      — Действителен по
#   {issuer}        — Издатель
#
# Naming.DateFormatPreset — формат дат {valid_from}/{valid_to}, одно из:
#   iso | ru_dot | ru_dash | compact | month | year | custom
# Naming.DateFormat используется, когда DateFormatPreset = custom,
# и задаётся кодами strftime: %Y — год (2026), %m — месяц, %d — день.
# Например: %Y — только год, %d.%m.%Y — 21.08.2026, %m-%Y — 08-2026.
#
# Extract.Certificates:
#   all  — извлекать все сертификаты, включая вышестоящие (УЦ)
#   user — только сертификаты пользователя
# Extract.AttributeCertificates:
#   no  — атрибутные сертификаты (AttributeCertificate) пропускаются
#   yes — извлекать и их тоже, в файлы .acr
#
# General.ShowGui:
#   yes — при запуске открывается окно программы
#   no  — окно не открывается, извлечение стартует сразу
#         и программа закрывается (результат — в файле log_*.txt)
# Открыть окно при ShowGui = no: запустить с ключом --gui
# Разово запустить без окна при ShowGui = yes: ключ --no-gui

[Paths]
InputFolder = 
OutputFolder = 

[Naming]
Preset = CN_serial_surname
Template = {CN}_{serial}_{surname}
DateFormatPreset = iso
DateFormat = %Y-%m-%d

[Extract]
Certificates = all
AttributeCertificates = no

[General]
ShowGui = yes
